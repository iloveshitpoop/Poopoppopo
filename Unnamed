      local function defineAlias(names, value, target)
        for _, name in (type(names) == 'string' and {names} or names) do
          local words = {}
          local start = nil
          for index, char in name:split('') do
            if not (char == char:lower() or char:upper() == char:lower()) then
              if start then
                table.insert(words, name:sub(start, index - 1))
              end
              start = index
            end
          end
          if start then
            table.insert(words, name:sub(start, #name))
          end
          local variants = {
            upper = words[1],
            lower = words[1]:lower(),
            underscore = words[1]:lower(),
            camel = words[1]:lower()
          }
          variants.camel = variants.camel .. words[1]:lower()
          for index = 2, #words do
            local word = words[index]
            variants.upper = variants.upper .. word
            variants.lower = variants.lower .. word:lower()
            variants.underscore = variants.underscore .. word:lower() .. '_'
            variants.camel = variants.camel .. word
          end
          variants.underscore = variants.underscore:sub(1, #variants.underscore - 1)
          for _, variant in variants do
            (target or class3)[variant] = value
          end
        end
