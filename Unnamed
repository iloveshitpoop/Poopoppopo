-- ---------------------------------------------------------------------------------------------
-- Compatibility layer (added for the readable version, not part of the original script)
--   * mobile / limited executors often lack some of the functions the script calls directly
--     (base64_decode, getrenv, makefolder, ...): missing ones get safe fallbacks so the UI can still build
--   * CoreGui may be unwritable: falls back to gethui() or PlayerGui
--   * if startup fails, the error is printed AND shown on screen (tap to dismiss), and the
--     UE_LOADED flag is cleared so the script can simply be executed again
-- ---------------------------------------------------------------------------------------------
local UE_genv = (getgenv or function() return _G end)()

local function UE_ensure(name, fallback)
  if UE_genv[name] == nil then
    UE_genv[name] = fallback
  end
end

local UE_B64 = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'

local function UE_b64decode(data)
  data = string.gsub(data, '[^%w%+/=]', '')
  local lookup = {}
  for i = 1, 64 do
    lookup[string.byte(UE_B64, i)] = i - 1
  end
  local out, n = {}, 0
  for i = 1, #data, 4 do
    local a, b, c, d = string.byte(data, i, i + 3)
    local v = (lookup[a] or 0) * 262144 + (lookup[b] or 0) * 4096 + (lookup[c] or 0) * 64 + (lookup[d] or 0)
    n = n + 1
    if lookup[c] == nil then
      out[n] = string.char(math.floor(v / 65536) % 256)
    elseif lookup[d] == nil then
      out[n] = string.char(math.floor(v / 65536) % 256, math.floor(v / 256) % 256)
    else
      out[n] = string.char(math.floor(v / 65536) % 256, math.floor(v / 256) % 256, v % 256)
    end
  end
  return table.concat(out)
end

local function UE_b64encode(data)
  local out, n = {}, 0
  for i = 1, #data, 3 do
    local a, b, c = string.byte(data, i, i + 2)
    local v = a * 65536 + (b or 0) * 256 + (c or 0)
    local c1, c2, c3, c4 = math.floor(v / 262144) % 64, math.floor(v / 4096) % 64, math.floor(v / 64) % 64, v % 64
    n = n + 1
    out[n] = string.sub(UE_B64, c1 + 1, c1 + 1) .. string.sub(UE_B64, c2 + 1, c2 + 1)
      .. (b and string.sub(UE_B64, c3 + 1, c3 + 1) or '=') .. (c and string.sub(UE_B64, c4 + 1, c4 + 1) or '=')
  end
  return table.concat(out)
end

do
  local cryptLib = UE_genv.crypt
  local decode = UE_genv.base64_decode or UE_genv.base64decode
  local encode = UE_genv.base64_encode or UE_genv.base64encode
  if type(cryptLib) == 'table' then
    decode = decode or cryptLib.base64decode or cryptLib.base64_decode or (type(cryptLib.base64) == 'table' and cryptLib.base64.decode)
    encode = encode or cryptLib.base64encode or cryptLib.base64_encode or (type(cryptLib.base64) == 'table' and cryptLib.base64.encode)
  end
  UE_ensure('base64_decode', decode or UE_b64decode)
  UE_ensure('base64_encode', encode or UE_b64encode)
  local lib = UE_genv.base64
  if type(lib) ~= 'table' then
    UE_genv.base64 = {encode = UE_genv.base64_encode, decode = UE_genv.base64_decode}
  else
    if lib.encode == nil then lib.encode = UE_genv.base64_encode end
    if lib.decode == nil then lib.decode = UE_genv.base64_decode end
  end
end

