do  -- in-memory file system, only used when the executor has no file functions at all
  local files, folders = {}, {}
  UE_ensure('makefolder', function(path) folders[path] = true end)
  UE_ensure('isfolder', function(path) return folders[path] == true end)
  UE_ensure('isfile', function(path) return files[path] ~= nil end)
  UE_ensure('writefile', function(path, contents) files[path] = tostring(contents) end)
  UE_ensure('readfile', function(path)
    if files[path] == nil then error('file not found: ' .. tostring(path)) end
    return files[path]
  end)
  UE_ensure('delfile', function(path) files[path] = nil end)
  UE_ensure('listfiles', function(path)
    local prefix, found = (path == '' and '' or path .. '/'), {}
    for name in pairs(files) do
      if string.sub(name, 1, #prefix) == prefix then table.insert(found, name) end
    end
    return found
  end)
end

local UE_coreGuiCache
local function UE_coreGui()
  if UE_coreGuiCache then return UE_coreGuiCache end
  local ok, gui = pcall(function() return game:GetService('CoreGui') end)
  local usable = false
  if ok and gui then
    usable = pcall(function()
      local probe = Instance.new('Folder')
      probe.Parent = gui
      probe:Destroy()
    end)
  end
  if not usable then
    local hidden = type(UE_genv.gethui) == 'function' and select(2, pcall(UE_genv.gethui))
    if typeof(hidden) == 'Instance' then
      gui = hidden
    else
      gui = game:GetService('Players').LocalPlayer:WaitForChild('PlayerGui')
    end
  end
  UE_coreGuiCache = gui
  return gui
end

-- the 3D background of the menu (a ScreenGui with ViewportFrame > ViewportFrame); falls back to an empty stand-in
local function UE_menuAsset()
  local ok, objects = pcall(function() return game:GetObjects('rbxassetid://93615626116769') end)
  local gui = ok and type(objects) == 'table' and objects[1] or nil
  if gui and gui:FindFirstChild('ViewportFrame') and gui.ViewportFrame:FindFirstChild('ViewportFrame') then
    return gui
  end
  gui = Instance.new('ScreenGui')
  gui.Name = 'ViewportGui'
  local outer = Instance.new('ViewportFrame')
  outer.Name = 'ViewportFrame'
  outer.Size = UDim2.fromScale(1, 1)
  outer.BackgroundTransparency = 1
  outer.Parent = gui
  local inner = Instance.new('ViewportFrame')
  inner.Name = 'ViewportFrame'
  inner.Size = UDim2.fromScale(1, 1)
  inner.BackgroundTransparency = 1
  inner.Parent = outer
  return gui
end

local function UE_showError(message)
  warn('[Unnamed Enhancements] ' .. message)
  pcall(function()
    local gui = Instance.new('ScreenGui')
    gui.Name = 'UE_Error'
    gui.DisplayOrder = 1000
    gui.ResetOnSpawn = false
    local label = Instance.new('TextButton')
    label.AutomaticSize = Enum.AutomaticSize.Y
    label.Size = UDim2.new(1, -20, 0, 40)
    label.Position = UDim2.new(0, 10, 0, 10)
    label.BackgroundColor3 = Color3.fromRGB(60, 0, 0)
    label.TextColor3 = Color3.new(1, 1, 1)
    label.TextWrapped = true
    label.TextSize = 14
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextYAlignment = Enum.TextYAlignment.Top
    label.Text = '[Unnamed Enhancements] failed to start (tap to dismiss)\n' .. string.sub(message, 1, 1000)
    label.Parent = gui
    gui.Parent = UE_coreGui()
    label.MouseButton1Click:Connect(function() gui:Destroy() end)
    task.delay(90, function() gui:Destroy() end)
  end)
end

local function UE_onError(err)
  UE_genv.UE_LOADED = nil
  local trace = ''
  pcall(function() trace = '\n' .. debug.traceback('', 2) end)
  UE_showError(tostring(err) .. trace)
  return err
end

-- Executor debug functions (getconstants, setconstant, hookfunction, ...) behave differently between executors and
-- break when the game updates a function: they throw instead of returning nil. A feature that cannot be set up is
-- skipped (and reported once in the console) instead of aborting the whole script.
local UE_failures = 0
local function UE_note(what, err)
  if UE_failures < 10 then
    UE_failures = UE_failures + 1
    warn('[Unnamed Enhancements] ' .. what .. ' skipped: ' .. tostring(err))
  end
end

local function UE_wrap(name, onFail)
  return function(...)
    local fn = UE_genv[name]
    if type(fn) ~= 'function' and type(debug) == 'table' then fn = debug[name] end
    if type(fn) ~= 'function' then return onFail(...) end
    local r = table.pack(pcall(fn, ...))
    if r[1] then return table.unpack(r, 2, r.n) end
    UE_note(name, r[2])
    return onFail(...)
  end
end

local UE_setconstant = UE_wrap('setconstant', function() end)
local UE_getconstants = UE_wrap('getconstants', function() return {} end)
local UE_getupvalues = UE_wrap('getupvalues', function() return {} end)
local UE_setupvalue = UE_wrap('setupvalue', function() end)
local UE_getproto = UE_wrap('getproto', function() return nil end)
local UE_getstack = UE_wrap('getstack', function(level, index) if index ~= nil then return nil end return {} end)
local UE_getconnections = UE_wrap('getconnections', function() return {} end)
local UE_hookfunction = UE_wrap('hookfunction', function(target) return target end)

-- the initial call of an :OnChanged(callback) handler: a failing feature must not stop the rest of the menu
local function UE_safeCall(fn, ...)
  local ok, err = pcall(fn, ...)
  if not ok then UE_note('feature initialisation', err) end
end

